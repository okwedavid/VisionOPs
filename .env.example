# ---------------------------------------------------------------------------
# VisionOps — example environment.
#
# Copy to `.env` and edit. NEVER commit `.env`; it is gitignored and holds real
# secrets. Every value below is a dummy or a safe default.
#
#   cp .env.example .env
#   make env        # generates a real API key and a master key for you
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
VISIONOPS_ENV=local
VISIONOPS_HOST=127.0.0.1
VISIONOPS_PORT=8000
VISIONOPS_LOG_LEVEL=INFO
VISIONOPS_LOG_FORMAT=console
# VISIONOPS_LOG_FILE=./data/logs/visionops.log

# --- Security ---------------------------------------------------------------
# Bootstrap API key. Created for you by `make env` / `visionops init`.
# Ignored once the organisation has any key of its own.
# VISIONOPS_API_KEY=vo_change-me_generate-with-make-env

# Master key for encrypting camera credentials (AES-256-GCM, 32 bytes base64).
# REQUIRED only if you store RTSP credentials. Losing it makes those
# credentials unrecoverable by design — back it up somewhere safe.
# VISIONOPS_MASTER_KEY=change-me-generate-with-make-env

# Comma-separated. Only trust proxy headers from proxies you control.
VISIONOPS_TRUSTED_PROXIES=
# Same-origin in production. Add origins only if the API is on another host.
VISIONOPS_CORS_ORIGINS=
VISIONOPS_RATE_LIMIT_RPS=10
VISIONOPS_AUTH_FAILURE_LIMIT=10
VISIONOPS_MAX_BODY_BYTES=1048576
VISIONOPS_MAX_SESSIONS=4
VISIONOPS_WS_MAX_FRAME_BYTES=2097152

# --- Data and storage -------------------------------------------------------
VISIONOPS_DATABASE_URL=sqlite:///./data/visionops.db
# postgresql+psycopg://visionops:change-me@127.0.0.1:5432/visionops
VISIONOPS_AUTO_MIGRATE=true
VISIONOPS_DATA_DIR=./data
VISIONOPS_SNAPSHOT_DIR=./data/snapshots
# Filesystem boundary for `file` sources — path traversal is refused outside it.
VISIONOPS_MEDIA_ROOT=./data/media
VISIONOPS_RETENTION_DAYS=90
VISIONOPS_AUDIT_RETENTION_DAYS=365

# --- Vision -----------------------------------------------------------------
VISIONOPS_MODEL_PATH=./models/yolo11n.onnx
VISIONOPS_MODEL_URL=https://github.com/ultralytics/assets/releases/download/v8.3.0/yolo11n.onnx
# Pin the checksum you trust; a mismatch is reported and the model is not used.
# VISIONOPS_MODEL_SHA256=
VISIONOPS_MODEL_AUTO_DOWNLOAD=true
VISIONOPS_ORT_PROVIDER=CPUExecutionProvider
# 0 lets ONNX Runtime decide. Pin it to share CPU predictably across cameras.
VISIONOPS_ORT_THREADS=0
VISIONOPS_INPUT_WIDTH=640
VISIONOPS_INPUT_HEIGHT=640
VISIONOPS_CONFIDENCE_THRESHOLD=0.35
VISIONOPS_NMS_IOU=0.45
VISIONOPS_CLASS_FILTER=person
VISIONOPS_TARGET_FPS=5
VISIONOPS_PUBLISH_FPS=10
VISIONOPS_TRACKER=kalman-iou
VISIONOPS_TRACKER_MAX_AGE=30
VISIONOPS_TRACKER_MIN_HITS=3
VISIONOPS_TRACKER_MATCH_IOU=0.3
VISIONOPS_PREVIEW_FPS=5
VISIONOPS_PREVIEW_WIDTH=640
# Better quality when downscaling wide scenes; slightly slower.
VISIONOPS_INTER_AREA=false

# --- Zones and sources ------------------------------------------------------
VISIONOPS_ZONE_COOLDOWN_SECONDS=10
VISIONOPS_ZONE_MIN_DWELL_SECONDS=0.5
VISIONOPS_SOURCE_OPEN_TIMEOUT_MS=5000
VISIONOPS_SOURCE_MAX_RETRIES=5
VISIONOPS_SOURCE_BACKOFF_SECONDS=2

# --- Frontend (dev server) --------------------------------------------------
# Only needed when the Vite dev server runs on a different port than the API.
VITE_API_BASE_URL=
