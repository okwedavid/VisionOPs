# syntax=docker/dockerfile:1
#
# VisionOps API + vision pipeline.
#
# Runtime image only: CPU inference via ONNX Runtime and headless OpenCV. The
# dependency set is installed from the committed `uv.lock` with `--frozen`, so a
# rebuild is reproducible. Model weights are *not* baked in — fetch them with
# `visionops model` (or mount a volume) so the image stays small and the weights
# stay pinnable by SHA-256.

ARG PYTHON_VERSION=3.12
ARG UV_VERSION=0.12.21

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM python:${PYTHON_VERSION}-slim AS runtime

# libgomp1: OpenMP runtime required by onnxruntime. libglib2.0-0: OpenCV.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    VISIONOPS_DATA_DIR=/data \
    VISIONOPS_SNAPSHOT_DIR=/data/snapshots \
    VISIONOPS_MEDIA_ROOT=/data/media \
    VISIONOPS_MODEL_PATH=/data/models/yolo11n.onnx \
    VISIONOPS_DATABASE_URL=sqlite:////data/visionops.db \
    VISIONOPS_HOST=0.0.0.0 \
    VISIONOPS_PORT=8000

WORKDIR /app

# Dependencies first, so the layer caches across source edits.
COPY pyproject.toml uv.lock ./
COPY backend ./backend
RUN uv sync --frozen --no-dev --no-editable

ENV PATH="/app/.venv/bin:${PATH}"

# Non-root runtime user; /data is a volume owned by it.
RUN useradd --system --uid 10001 --home /app --shell /usr/sbin/nologin visionops \
    && mkdir -p /data \
    && chown -R visionops:visionops /app /data
USER visionops

VOLUME ["/data"]
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/v1/healthz', timeout=4).status == 200 else 1)"

# `visionops serve` builds the app through the same factory and lifespan the
# docs tell operators to use (ADR-023).
ENTRYPOINT ["visionops", "serve"]
