[Unit]
Description=VisionOps retention and prune job
Documentation=file:/opt/visionops/app/docs/DEPLOYMENT.md
After=network-online.target

[Service]
Type=oneshot
User=visionops
Group=visionops
WorkingDirectory=/opt/visionops/app
EnvironmentFile=/etc/visionops.env
Environment=VISIONOPS_DATA_DIR=/var/lib/visionops/data
Environment=VISIONOPS_SNAPSHOT_DIR=/var/lib/visionops/snapshots
Environment=VISIONOPS_MEDIA_ROOT=/var/lib/visionops/media
Environment=VISIONOPS_MODEL_PATH=/var/lib/visionops/models/yolo11n.onnx
ExecStart=/opt/visionops/app/.venv/bin/visionops prune
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/visionops
